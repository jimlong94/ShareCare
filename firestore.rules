rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // 1. Is the user actually logged in?
    function isSignedIn() {
      return request.auth != null;
    }

    // 2. Fetch the current user's profile from Firestore to find their Group ID
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 3. Check if the user belongs to the target Group ID
    function isGroupMember(groupId) {
      return isSignedIn() && getUserData().groupId == groupId;
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection
    // - Read: Yourself OR people in your group (for the Team list)
    // - Write: Yourself only (for profile updates/joining groups)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || resource.data.groupId == getUserData().groupId);
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // 2. Groups Collection
    // - Create: Anyone signed in (Start Hub)
    // - Read/Update: Only members of that group
    match /groups/{groupId} {
      allow create: if isSignedIn();
      allow read, update: if isGroupMember(groupId);
    }

    // 3. Tasks (The Core Work)
    match /tasks/{taskId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId);
      allow update, delete: if isGroupMember(resource.data.groupId);
    }

    // 4. The Vault (Encrypted Data)
    // Strict enforcement: You must be in the group to even peek at these.
    match /key_documents/{docId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId);
      allow update, delete: if isGroupMember(resource.data.groupId);
    }
    match /key_providers/{docId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId);
      allow update, delete: if isGroupMember(resource.data.groupId);
    }
    match /key_notes/{docId} {
      allow read: if isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId);
      allow update, delete: if isGroupMember(resource.data.groupId);
    }

    // 5. Invites
    // - Read: Public (Required for joining via code)
    // - Create/Update: Signed in users only
    match /invites/{inviteId} {
      allow read: if true; 
      allow create, update: if isSignedIn();
    }
  }
}